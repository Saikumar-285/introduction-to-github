import java.util.Scanner;

public class DataStructureGitHub {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int[] numbers = new int[5];

        // Taking user input
        System.out.println("Enter 5 different numbers:");
        for (int i = 0; i < 5; i++) {
            numbers[i] = scanner.nextInt();
        }

        scanner.close();

        // Sorting the array
        bubbleSort(numbers);

        // Finding second lowest and second highest manually
        int secondLowest = numbers[1];  // Since it's sorted, second element is second lowest
        int secondHighest = numbers[numbers.length - 2]; // Second last element is second highest

        // Display results
        System.out.println("Sorted array: ");
        for (int num : numbers) {
            System.out.print(num + " ");
        }
        System.out.println("\nSecond Lowest: " + secondLowest);
        System.out.println("Second Highest: " + secondHighest);
    }

    // Bubble Sort algorithm
    public static void bubbleSort(int[] arr) {
        int n = arr.length;
        for (int i = 0; i < n - 1; i++) {
            for (int j = 0; j < n - i - 1; j++) {
                if (arr[j] > arr[j + 1]) {
                    // Swap arr[j] and arr[j+1]
                    int temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;
